# ============================================================
#  Radar SEO IA - configuración
#  Copia este archivo como .env (iniciar.bat lo hace solo) y
#  pega tus claves. TODAS son opcionales: sin claves igual se
#  hace la auditoría técnica de SEO local, GEO y AEO.
# ============================================================

# --- IAs para medir visibilidad real (usan búsqueda web) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# https://console.anthropic.com/settings/keys  (activa "web search" en tu organización)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# https://aistudio.google.com/apikey  (Gemini con Google Search)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# --- Velocidad (opcional, evita límites de uso) ---
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- Ajustes ---
PAIS=PE
CIUDAD_DEFECTO=Lima
MAX_PAGINAS=6
PUERTO=5050
